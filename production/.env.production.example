# ============================================================
# Production environment template
# ============================================================
# Copy to production/.env and fill in every value marked CHANGE-ME.
# It sits next to docker-compose.yml, which both interpolates ${VAR} from it
# and passes it to the containers via env_file.
# Never commit the filled-in .env.
# ============================================================

APP_NAME="HelloFresh Database"
APP_ENV=production
# Generate with: docker compose run --rm app php artisan key:generate --show
APP_KEY=CHANGE-ME
APP_DEBUG=false
APP_URL=https://CHANGE-ME.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Host port nginx binds to. Keep 80 behind a TLS-terminating proxy.
APP_PORT=80
# Domains nginx should answer for; "_" catches everything.
NGINX_SERVER_NAME=CHANGE-ME.example.com

API_DOMAIN_NAME=api.CHANGE-ME.example.com
API_VERSION=

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database ────────────────────────────────────────────────
# DB_HOST must stay "postgres": it is the service name on the compose network.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hellofresh
DB_USERNAME=hellofresh
DB_PASSWORD=CHANGE-ME

# ── Redis ───────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Sessions / cache / queues ───────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.CHANGE-ME.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Raise only if the host has cores to spare; see config/horizon.php.
HORIZON_HELLO_FRESH_MAX_PROCESSES=8
HORIZON_IMPORT_MAX_PROCESSES=24

# ── Mail ────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=CHANGE-ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE-ME
MAIL_PASSWORD=CHANGE-ME
MAIL_FROM_ADDRESS="noreply@CHANGE-ME.example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ALWAYS_TO=

# ── Error tracking (optional) ───────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Reverb (optional, only if websockets are used) ──────────
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=
REVERB_SCHEME=https

# ── Vite build-time values ──────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_APP_DEBUG="${APP_DEBUG}"
VITE_SENTRY_DSN_PUBLIC="${SENTRY_LARAVEL_DSN}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
